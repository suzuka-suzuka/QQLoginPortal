{
  "name": "qq-login-portal",
  "version": "0.1.0",
  "description": "Multi-instance Linux QQ login manager using QR codes emitted directly by the QQ login kernel",
  "private": true,
  "type": "module",
  "scripts": {
    "init-config": "node src/cli.mjs init ./config.json",
    "start": "node src/server.mjs --config ./config.json",
    "check": "node src/cli.mjs check ./config.json",
    "loader:status": "node src/cli.mjs loader-status ./config.json",
    "loader:install": "node src/cli.mjs loader-install ./config.json",
    "loader:restore": "node src/cli.mjs loader-restore ./config.json",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
